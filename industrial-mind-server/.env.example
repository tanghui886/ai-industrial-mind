# ===== ContainerMind 后端配置 =====
# 数据库连接（默认 SQLite，开箱即用；如需 MySQL 8.0 可切换为下方示例）
DATABASE_URL=sqlite:///./data/containermind.db
# DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/containermind?charset=utf8mb4

# ===== 大模型配置（可选，不配置则使用内置规则引擎，系统同样可运行）=====
# deepseek-v4-flash-0731 兼容 OpenAI 接口协议
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash-0731
